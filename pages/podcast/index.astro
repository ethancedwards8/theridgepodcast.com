---

<BaseLayout title="Episode Archive" description="The Ridge Podcast Episode Archive">
    <h1>Episode Archive:</h1>
    <div>
        {posts.map((post, index) => (
            <div key={index}>
                <EpisodeCard post={post} />
            </div>
        ))}
    </div>
</BaseLayout>
