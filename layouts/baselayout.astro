function makeTitle(title: string): string {
    if (!title) {
        return "The Ridge Podcast";
    } else {
        return `${title} | The Ridge Podcast`;
    }
}

---

<html lang="en">
    <head>
        <SEO
            title={makeTitle(title)}
            description={description}
        />

        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1" />
    </head>

    <body>

    <div>
